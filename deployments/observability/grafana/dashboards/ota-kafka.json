  "panels": [
    {
      "type": "timeseries",
      "title": "Kafka Consumer Lag by Topic",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {"expr": "sum(kafka_consumergroup_lag) by (topic, consumergroup)", "legendFormat": "{{consumergroup}} / {{topic}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Kafka Consumer Lag by Group",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "sum(kafka_consumergroup_lag_sum) by (consumergroup)", "legendFormat": "{{consumergroup}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Kafka Topic Throughput by Offset Change (1m)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {"expr": "sum(clamp_min(delta(kafka_topic_partition_current_offset[1m]), 0)) by (topic) / 60", "legendFormat": "{{topic}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Kafka Topic Partitions and Leaders",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "sum(kafka_topic_partitions) by (topic)", "legendFormat": "{{topic}} partitions"},
        {"expr": "sum(kafka_topic_partition_leader) by (topic)", "legendFormat": "{{topic}} leaders"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Kafka Consumer Group Offsets",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {"expr": "sum(kafka_consumergroup_current_offset) by (consumergroup)", "legendFormat": "{{consumergroup}} current"},
        {"expr": "sum(kafka_consumergroup_lag) by (consumergroup)", "legendFormat": "{{consumergroup}} lag"}
      ]
    },
    {
      "type": "stat",
      "title": "Kafka Brokers",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 16},
      "targets": [
        {"expr": "kafka_brokers", "legendFormat": "brokers"}
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto"}
    },
    {
      "type": "stat",
      "title": "Topics",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 16},
