{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "SMPP Deliver Queue",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "SMPP Deliver Queue Depth",
      "description": "Current number of items in the SMPP deliver queue. High values = DLR/MO processing can't keep up.",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 1},
      "targets": [
        {
          "expr": "ota_smpp_deliver_queue_depth",
          "legendFormat": "queue depth"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {"lineWidth": 2, "fillOpacity": 20, "spanNulls": false, "showPoints": "never"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 4096},
              {"color": "red", "value": 7000}
            ]
          },
          "color": {"mode": "thresholds"}
        },
        "overrides": []
      },
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "list", "placement": "bottom"}
      }
    },
    {
      "type": "row",
      "title": "Processing Latency",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9},
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Executor Event Processing p99 (ms)",
      "description": "99th percentile processing time per event type. Rising latency = early warning of overload.",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 10},
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, ota_event_type) (rate(ota_executor_processing_duration_ms_bucket[1m])))",
          "legendFormat": "p99 {{ota_event_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {"lineWidth": 2, "fillOpacity": 10, "spanNulls": false, "showPoints": "never"}
        },
        "overrides": []
      },
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}
      }
    },
    {
      "type": "row",
      "title": "Throughput",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 18},
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Executor Events/sec by Type",
      "description": "Processing rate per event type. Drop in throughput while lag rises = bottleneck.",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 19},
      "targets": [
        {
          "expr": "sum by (ota_event_type) (rate(ota_executor_events_processed_total[1m]))",
          "legendFormat": "{{ota_event_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {"lineWidth": 2, "fillOpacity": 15, "spanNulls": false, "showPoints": "never"}
        },
        "overrides": []
      },
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["ota", "backpressure", "overload"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "OTA Platform - Backpressure & Overload",
  "uid": "ota-backpressure",
  "version": 1
}
