  "links": [],
  "panels": [
    {
      "type": "timeseries",
      "title": "Kafka Consumer Lag by Group",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
      "targets": [
        {"expr": "sum(kafka_consumergroup_lag_sum) by (consumergroup)", "legendFormat": "{{consumergroup}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Kafka Topic Partitions and Brokers",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {"expr": "kafka_brokers", "legendFormat": "brokers"},
        {"expr": "sum(kafka_topic_partitions)", "legendFormat": "topic partitions"}
      ]
    },
    {
      "type": "timeseries",
      "title": "PostgreSQL Connections and Commits",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "pg_stat_database_numbackends{datname=\"ota_platform\"}", "legendFormat": "connections"},
        {"expr": "rate(pg_stat_database_xact_commit{datname=\"ota_platform\"}[1m])", "legendFormat": "commits/sec"},
        {"expr": "rate(pg_stat_database_xact_rollback{datname=\"ota_platform\"}[1m])", "legendFormat": "rollbacks/sec"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Scylla Coordinator Throughput",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {"expr": "sum(rate(scylla_storage_proxy_coordinator_read_latency_count[1m]))", "legendFormat": "reads/sec"},
        {"expr": "sum(rate(scylla_storage_proxy_coordinator_write_latency_count[1m]))", "legendFormat": "writes/sec"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Scylla Average Coordinator Latency (ms)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {"expr": "1000 * sum(rate(scylla_storage_proxy_coordinator_read_latency_sum[1m])) / clamp_min(sum(rate(scylla_storage_proxy_coordinator_read_latency_count[1m])), 1)", "legendFormat": "read avg ms"},
        {"expr": "1000 * sum(rate(scylla_storage_proxy_coordinator_write_latency_sum[1m])) / clamp_min(sum(rate(scylla_storage_proxy_coordinator_write_latency_count[1m])), 1)", "legendFormat": "write avg ms"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Dragonfly Core Metrics",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
      "targets": [
        {"expr": "dragonfly_connected_clients", "legendFormat": "connected clients"},
        {"expr": "dragonfly_blocked_clients", "legendFormat": "blocked clients"},
        {"expr": "dragonfly_keys", "legendFormat": "keys"},
        {"expr": "dragonfly_used_memory", "legendFormat": "used memory bytes"}
      ]
    }
  ],
