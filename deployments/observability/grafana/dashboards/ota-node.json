    {
      "type": "timeseries",
      "title": "Disk I/O",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "rate(node_disk_read_bytes_total[1m])",
