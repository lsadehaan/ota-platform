        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ota_bus_mo_ch_depth",
          "legendFormat": "MOCh"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ota_bus_message_log_ch_depth",
          "legendFormat": "MessageLogCh"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ota_bus_card_state_ch_depth",
          "legendFormat": "CardStateCh"
        }
