{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Campaign TPS",
      "description": "Rate of cards processed per second across all campaigns",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(ota_executor_cards_processed_total[$__rate_interval]))",
          "legendFormat": "Cards/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "cps",
          "custom": {"lineWidth": 2, "fillOpacity": 15, "spanNulls": false, "showPoints": "never", "gradientMode": "scheme"}
        },
        "overrides": []
      },
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "last"]}
      }
    },
    {
      "type": "timeseries",
      "title": "Events/sec by Type",
      "description": "Rate of events processed, broken down by event type",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (ota_event_type) (rate(ota_executor_events_processed_total[$__rate_interval]))",
          "legendFormat": "{{ota_event_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "ops",
          "custom": {"lineWidth": 2, "fillOpacity": 10, "spanNulls": false, "showPoints": "never"}
        },
        "overrides": []
      },
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "last"]}
      }
    },
    {
      "type": "stat",
      "title": "Message Log Drops",
      "description": "Total messages dropped from the message log channel (non-blocking send)",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ota_bus_message_log_dropped",
          "legendFormat": "Drops"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 100}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "reduceOptions": {"calcs": ["last"]}
      }
    },

    {
      "type": "row",
      "title": "Channel Depths",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9},
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Channel Depths",
      "description": "Current depth of all in-process Go channels (ActivateCh, SendSMSCh, DLRCh, MOCh, MessageLogCh, CardStateCh)",
